{
  "name": "@vincweb/zeus",
  "version": "0.1.0",
  "description": "Orchestrate a fleet of git repositories: the registry of the repos you follow, their state, clone and update in one click, and the cross-project tools that go with them",
  "keywords": [
    "git",
    "github",
    "repositories",
    "fleet",
    "multi-repo",
    "dashboard",
    "orchestrator",
    "cli",
    "devtools",
    "claude-code"
  ],
  "homepage": "https://github.com/Vincweb/zeus#readme",
  "bugs": "https://github.com/Vincweb/zeus/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vincweb/zeus.git"
  },
  "author": "Vincent Caudron (https://github.com/Vincweb)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "@vincweb:registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "zeus": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx src/cli.ts",
    "dev:web": "vite",
    "build": "tsup && vite build",
    "lint": "eslint .",
    "type-check": "tsc",
    "test": "tsx --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
